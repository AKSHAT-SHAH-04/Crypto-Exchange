generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SYSTEM
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
  STOP_LIMIT
  TRAILING_STOP
}

enum OrderStatus {
  PENDING_TRIGGER
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELED
  REJECTED
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  BONUS
  ADJUSTMENT
  TRANSFER
  P2P
  CONVERT
}

enum TxStatus {
  AWAITING_EMAIL
  PENDING_APPROVAL
  COMPLETED
  REJECTED
  CANCELED
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  CONFIRM_WITHDRAWAL
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String?
  googleId        String?   @unique
  emailVerified   Boolean   @default(false)
  role            Role      @default(USER)
  frozen          Boolean   @default(false)
  totpSecret      String?
  totpEnabled     Boolean   @default(false)
  tokenVersion    Int       @default(0)
  kycStatus       KycStatus @default(NONE)
  /// Pay trading fees with the discount token (FEE_DISCOUNT_ASSET) when possible
  payFeesWithToken Boolean  @default(false)
  /// Admin override for the VIP fee tier
  vipOverride     Int?
  /// Set for sub-accounts: the master account that owns this one
  parentId        String?
  subLabel        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parent          User?     @relation("SubAccounts", fields: [parentId], references: [id], onDelete: Cascade)
  subAccounts     User[]    @relation("SubAccounts")
  notifications   Notification[]
  alerts          PriceAlert[]
  tickets         SupportTicket[]
  converts        ConvertTrade[]
  paymentMethods  P2PPaymentMethod[]
  p2pAds          P2PAd[]

  balances        Balance[]
  orders          Order[]
  transactions    Transaction[]
  addresses       WithdrawalAddress[]
  kyc             KycSubmission[]
  apiKeys         ApiKey[]
  auditLogs       AuditLog[]
  tokens          Token[]
  favorites       Favorite[]
}

model Asset {
  symbol     String   @id
  name       String
  precision  Int      @default(8)
  networks   String[]
  minWithdraw Decimal @default(0) @db.Decimal(36, 18)
  withdrawFee Decimal @default(0) @db.Decimal(36, 18)
  enabled    Boolean  @default(true)
}

model Pair {
  symbol         String   @id // e.g. BTCUSDT
  base           String
  quote          String
  pricePrecision Int      @default(2)
  qtyPrecision   Int      @default(6)
  minNotional    Decimal  @default(5) @db.Decimal(36, 18)
  makerFee       Decimal  @default(0.001) @db.Decimal(10, 6)
  takerFee       Decimal  @default(0.001) @db.Decimal(10, 6)
  enabled        Boolean  @default(true)
  seedPrice      Decimal  @default(1) @db.Decimal(36, 18)
  sortOrder      Int      @default(100)
  createdAt      DateTime @default(now())
}

model Balance {
  userId    String
  asset     String
  available Decimal @default(0) @db.Decimal(36, 18)
  locked    Decimal @default(0) @db.Decimal(36, 18)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, asset])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  symbol      String
  side        OrderSide
  type        OrderType
  status      OrderStatus
  price       Decimal?    @db.Decimal(36, 18)
  stopPrice   Decimal?    @db.Decimal(36, 18)
  quantity    Decimal     @db.Decimal(36, 18)
  filledQty   Decimal     @default(0) @db.Decimal(36, 18)
  quoteFilled Decimal     @default(0) @db.Decimal(36, 18)
  // Quote reserved per unit of base for BUY orders (limit price, or worst fill price for market buys)
  lockPrice   Decimal?    @db.Decimal(36, 18)
  /// Links the two legs of an OCO order
  ocoId       String?
  /// Trailing stop callback rate as a fraction (0.01 = 1%)
  trailingDelta Decimal?  @db.Decimal(10, 6)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([symbol, status])
  @@index([ocoId])
}

model Trade {
  id          String    @id @default(cuid())
  symbol      String
  price       Decimal   @db.Decimal(36, 18)
  quantity    Decimal   @db.Decimal(36, 18)
  takerSide   OrderSide
  buyOrderId  String?
  sellOrderId String?
  buyerId     String?
  sellerId    String?
  buyerFee    Decimal   @default(0) @db.Decimal(36, 18)
  sellerFee   Decimal   @default(0) @db.Decimal(36, 18)
  buyerFeeAsset  String?
  sellerFeeAsset String?
  /// Total fees collected on this trade, valued in USD at execution
  feeUsd      Decimal   @default(0) @db.Decimal(36, 18)
  createdAt   DateTime  @default(now())

  @@index([symbol, createdAt])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  type        TxType
  status      TxStatus
  asset       String
  network     String?
  amount      Decimal   @db.Decimal(36, 18)
  fee         Decimal   @default(0) @db.Decimal(36, 18)
  address     String?
  txHash      String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, status])
}

model WithdrawalAddress {
  id        String   @id @default(cuid())
  userId    String
  asset     String
  network   String
  address   String
  label     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asset, network, address])
}

model KycSubmission {
  id          String    @id @default(cuid())
  userId      String
  fullName    String
  dateOfBirth String
  country     String
  idType      String
  idNumber    String
  status      KycStatus @default(PENDING)
  reviewNote  String?
  reviewedBy  String?
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ApiKey {
  id              String    @id @default(cuid())
  userId          String
  label           String
  key             String    @unique
  secretEncrypted String
  canTrade        Boolean   @default(false)
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Token {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  refId     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId String
  symbol String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, symbol])
}

model Setting {
  key   String @id
  value Json
}

// ---------------- Convert ----------------

model ConvertTrade {
  id         String   @id @default(cuid())
  userId     String
  fromAsset  String
  toAsset    String
  fromAmount Decimal  @db.Decimal(36, 18)
  toAmount   Decimal  @db.Decimal(36, 18)
  price      Decimal  @db.Decimal(36, 18)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------- Alerts & notifications ----------------

enum AlertDirection {
  ABOVE
  BELOW
}

model PriceAlert {
  id          String         @id @default(cuid())
  userId      String
  symbol      String
  direction   AlertDirection
  price       Decimal        @db.Decimal(36, 18)
  note        String?
  active      Boolean        @default(true)
  triggeredAt DateTime?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String   @default("General")
  pinned    Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

// ---------------- Support ----------------

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SupportTicket {
  id        String          @id @default(cuid())
  userId    String
  subject   String
  category  String
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([status, updatedAt])
  @@index([userId])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String
  staff     Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ---------------- P2P ----------------

enum P2PSide {
  BUY
  SELL
}

enum P2PAdStatus {
  ONLINE
  OFFLINE
  CLOSED
}

enum P2POrderStatus {
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELED
  DISPUTED
}

model P2PPaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  type      String // UPI | BANK | IMPS | PAYTM
  label     String
  details   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model P2PAd {
  id           String      @id @default(cuid())
  userId       String
  /// Side from the advertiser's point of view
  side         P2PSide
  asset        String
  fiat         String      @default("INR")
  price        Decimal     @db.Decimal(36, 8)
  totalAmount  Decimal     @db.Decimal(36, 18)
  remaining    Decimal     @db.Decimal(36, 18)
  minFiat      Decimal     @db.Decimal(36, 2)
  maxFiat      Decimal     @db.Decimal(36, 2)
  paymentTypes String[]
  terms        String?
  payWindowMin Int         @default(15)
  status       P2PAdStatus @default(ONLINE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       P2POrder[]

  @@index([status, side, asset])
}

model P2POrder {
  id            String         @id @default(cuid())
  adId          String
  makerId       String
  buyerId       String
  sellerId      String
  asset         String
  fiat          String
  price         Decimal        @db.Decimal(36, 8)
  amount        Decimal        @db.Decimal(36, 18)
  fiatAmount    Decimal        @db.Decimal(36, 2)
  status        P2POrderStatus @default(PENDING_PAYMENT)
  expiresAt     DateTime
  paidAt        DateTime?
  completedAt   DateTime?
  cancelReason  String?
  disputeReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ad            P2PAd          @relation(fields: [adId], references: [id])
  messages      P2PMessage[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
}

model P2PMessage {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String?
  system    Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())
  order     P2POrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}
